{
  "name": "esedre",
  "version": "1.0.1",
  "description": "Esedre: Developer roadmap, ticketing, and LLM coding partner coordination platform",
  "homepage": "https://esedre.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aellinsar/esedre.git"
  },
  "author": "ARWAM <dev@arwam.com>",
  "keywords": [
    "roadmap",
    "ticketing",
    "mcp",
    "model-context-protocol",
    "agent",
    "planning",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "main": "./dist/esedre.mjs",
  "bin": {
    "esedre": "dist/esedre.mjs",
    "ese": "dist/esedre.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/assets"
  ],
  "scripts": {
    "dev": "vite --port=5674",
    "net": "node tools/tunnel/run-net.js",
    "net:all": "node tools/tunnel/run-net.js --all",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build:cli": "node scripts/build.js",
    "build:ui": "vite build --config vite.config.ts",
    "build": "npm run lint && npm run build:ui && npm run build:cli",
    "bridge": "node scripts/bridge.js",
    "pub": "node scripts/publish.js",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MPL-2.0",
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0"
  }
}
